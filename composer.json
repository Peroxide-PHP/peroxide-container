{
    "name": "peroxide/container",
    "description": "Peroxide Container, a simple factory-driven PSR-11 Dependency Injection Container with zero dependencies and low functionalities.",
    "require": {
        "php": "^8.2",
        "psr/container": "^2.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Peroxide\\DependencyInjection\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "tests": "phpunit",
        "coverage": "XDEBUG_MODE=coverage phpunit --coverage-html coverage"
    },
    "authors": [
        {
            "name": "Leonardo Tumadjian",
            "email": "tumadjian@gmail.com"
        }
    ]
}
